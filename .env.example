# PostgreSQL — single DATABASE_URL for Drizzle + Better Auth (no supabase-js needed for the DB)

# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skl

# Supabase (recommended when Direct times out — ORMs → Drizzle snippet):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Copy from: Project Settings → Database → ORMs → Drizzle → .env tab
# User is postgres.<project-ref>, host ends with pooler.supabase.com, port 6543
#
# Wrong: host YOUR_REF.supabase.co only (API — migrate will error)
# Direct (db.*.supabase.co:5432) often needs IPv6 or Supabase IPv4 add-on — migrate blocks it unless SKL_ALLOW_SUPABASE_DIRECT=1
#
# Then: pnpm db:migrate

# Public URL of this app (used by Better Auth client and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CLI (`skl install` from @skl/cli) — optional; defaults to http://localhost:3000 when unset
# SKL_REGISTRY=https://your-production-domain
# SKL_TOKEN=  # Bearer token when the registry requires auth (reserved for future use)

# Public URL to use specifically inside emails.
# Set this to your real production domain so email profile links and avatars do not point at localhost.
# EMAIL_PUBLIC_APP_URL=https://your-domain.com

# Better Auth — min 32 chars, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: in development, set to 1 to print Better Auth logs to stderr (terminal only; not mirrored to the browser).
# If unset, the Better Auth logger is disabled in dev.
# AUTH_VERBOSE=1

# Optional; defaults to NEXT_PUBLIC_APP_URL if unset
# BETTER_AUTH_URL=http://localhost:3000

# Optional: comma-separated extra origins for Better Auth (apex + www are auto-added from BETTER_AUTH_URL)
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com,https://example.com

# Google OAuth (optional) — enables “Continue with Google” on login/signup when both are set.
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URIs must include:
#   {BETTER_AUTH_URL or NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google and https://your-domain.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend — transactional email (e.g. scripts/send-profile-emails.ts)
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# Sender must be verified in Resend (use onboarding@resend.dev only for testing)
# EMAIL_FROM=SKL <onboarding@resend.dev>
# Optional: sync users into a Resend Audience for dashboard campaigns
# RESEND_AUDIENCE_ID=aud_...
