NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth signs and validates sessions with this secret.
# Generate a long random string, at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Supabase Postgres or any standard PostgreSQL connection string.
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skl
#
# Supabase example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
